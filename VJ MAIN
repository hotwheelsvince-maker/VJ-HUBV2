--========================================================--
-- DRAG SYSTEM
--========================================================--

local function MakeDraggable(Object)

	local Dragging = false
	local DragStart
	local StartPosition

	Object.InputBegan:Connect(function(Input)

		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			Dragging = true

			DragStart = Input.Position
			StartPosition = Object.Position

			Input.Changed:Connect(function()

				if Input.UserInputState == Enum.UserInputState.End then
					Dragging = false
				end

			end)

		end

	end)

	UserInputService.InputChanged:Connect(function(Input)

		if not Dragging then
			return
		end

		if Input.UserInputType == Enum.UserInputType.MouseMovement
			or Input.UserInputType == Enum.UserInputType.Touch then

			local Delta = Input.Position - DragStart

			Object.Position = UDim2.new(
				StartPosition.X.Scale,
				StartPosition.X.Offset + Delta.X,

				StartPosition.Y.Scale,
				StartPosition.Y.Offset + Delta.Y
			)

		end

	end)

end

MakeDraggable(Main)

--========================================================--
-- FLY VARIABLES
--========================================================--

local Flying = false

local FlySpeed = DEFAULT_FLY_SPEED

local FlyAttachment
local FlyVelocity

--========================================================--
-- START FLY
--========================================================--

local function StartFly()

	if not RootPart or not Humanoid then
		return
	end

	Flying = true

	FlyButton.Text = "✈  FLY : ON"

	FlyAttachment = Instance.new("Attachment")

	FlyAttachment.Name = "VJFlyAttachment"

	FlyAttachment.Parent = RootPart

	FlyVelocity = Instance.new("LinearVelocity")

	FlyVelocity.Name = "VJFlyVelocity"

	FlyVelocity.Attachment0 = FlyAttachment

	FlyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World

	FlyVelocity.MaxForce = math.huge

	FlyVelocity.VectorVelocity = Vector3.zero

	FlyVelocity.Parent = RootPart

end

--========================================================--
-- STOP FLY
--========================================================--

local function StopFly()

	Flying = false

	FlyButton.Text = "✈  FLY : OFF"

	if FlyVelocity then

		FlyVelocity:Destroy()

		FlyVelocity = nil

	end

	if FlyAttachment then

		FlyAttachment:Destroy()

		FlyAttachment = nil

	end

	if RootPart then

		RootPart.AssemblyLinearVelocity = Vector3.zero

	end

end

--========================================================--
-- MOBILE JOYSTICK FLY
--========================================================--

RunService.RenderStepped:Connect(function()

	if not Flying then
		return
	end

	if not RootPart then
		return
	end

	if not Humanoid then
		return
	end

	if not FlyVelocity then
		return
	end

	local Camera = workspace.CurrentCamera

	-- Roblox's built-in mobile joystick
	local MoveDirection = Humanoid.MoveDirection

	local Magnitude = MoveDirection.Magnitude

	local Direction = Vector3.zero

	if Magnitude > 0.01 then

		-- Camera forward direction
		local Look = Camera.CFrame.LookVector

		-- Joystick controls how much movement occurs
		Direction = Look * Magnitude

	end

	-- Keyboard vertical controls
	if UserInputService:IsKeyDown(Enum.KeyCode.Space) then

		Direction += Vector3.new(0,1,0)

	end

	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then

		Direction -= Vector3.new(0,1,0)

	end

	-- Normalize so diagonal movement doesn't become faster
	if Direction.Magnitude > 1 then

		Direction = Direction.Unit

	end

	FlyVelocity.VectorVelocity = Direction * FlySpeed

end)

--========================================================--
-- NOCLIP
--========================================================--

local Noclip = false

local function ToggleNoclip()

	Noclip = not Noclip

	if Noclip then

		NoclipButton.Text = "👻  NOCLIP : ON"

	else

		NoclipButton.Text = "👻  NOCLIP : OFF"

		if Character then

			for _,Part in ipairs(Character:GetDescendants()) do

				if Part:IsA("BasePart") then

					Part.CanCollide = true

				end

			end

		end

	end

end

RunService.Stepped:Connect(function()

	if not Noclip then
		return
	end

	if not Character then
		return
	end

	for _,Part in ipairs(Character:GetDescendants()) do

		if Part:IsA("BasePart") then

			Part.CanCollide = false

		end

	end

end)

--========================================================--
-- APPLY SETTINGS
--========================================================--

local function ApplySettings()

	-- WalkSpeed
	if Humanoid then

		local Speed = tonumber(WalkSpeedBox.Text)

		if Speed then

			Speed = math.clamp(
				Speed,
				0,
				MAX_WALK_SPEED
			)

			Humanoid.WalkSpeed = Speed

			WalkSpeedBox.Text = tostring(Speed)

		end

	end

	-- FlySpeed
	local NewFlySpeed = tonumber(FlySpeedBox.Text)

	if NewFlySpeed then

		FlySpeed = math.clamp(
			NewFlySpeed,
			1,
			MAX_FLY_SPEED
		)

		FlySpeedBox.Text = tostring(FlySpeed)

	end

end

